# Local address. Use 0.0.0.0 if other classroom devices should connect.
APP_HOST=127.0.0.1
APP_PORT=8080
# Host-side MySQL mapping. Container-to-container connections still use mysql:3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
# Set these before the first launch. Existing MySQL volumes keep their original password.
MYSQL_PASSWORD=classpet_local_change_me
MYSQL_ROOT_PASSWORD=classpet_root_local_change_me
