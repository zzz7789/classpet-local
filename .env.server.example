# Public web port.
APP_HOST=0.0.0.0
APP_PORT=21117
# Database access on the server itself. Use an SSH tunnel for remote management.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=21119
# start-server.sh generates random passwords on first launch.
MYSQL_PASSWORD=replace_before_first_start
MYSQL_ROOT_PASSWORD=replace_before_first_start
